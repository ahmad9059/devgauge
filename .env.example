# Copy to .env.local and fill in real values. Never commit secrets.

# --- API (apps/api) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (empty = none in production).
CORS_ORIGINS=

# --- Feature flags / kill switches ---
FEATURE_MOCK_TRANSPORT=false
FLAG_PROVIDER_MUTATION_CODEX_RESET_CREDIT=false
KILLSWITCH_PROVIDER_OPENCODE_GO=false
KILLSWITCH_PROVIDER_GITHUB_COPILOT=false
KILLSWITCH_PROVIDER_CODEX=false
KILLSWITCH_PROVIDER_CLAUDE_CODE=false

# --- Worker (apps/connector-worker) ---
REDIS_URL=redis://localhost:6379
QUEUE_REFRESH_NAME=refresh
WORKER_CONCURRENCY=1
JOB_TIMEOUT_MS=60000

# --- Database (Phase 4 connects this; required in production) ---
DATABASE_URL=postgres://devgauge:devgauge@localhost:5432/devgauge

# --- Object storage (local MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=devgauge
S3_ACCESS_KEY_ID=devgauge
S3_SECRET_ACCESS_KEY=devgauge-secret

# --- Placeholders for later phases; do not invent values ---
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# KMS_KEY_ID=
# PUSH_SERVICE_URL=