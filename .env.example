# Copy to .env.local and fill in real values. Never commit secrets.

# --- API (apps/api) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (empty = none in production).
CORS_ORIGINS=

# --- Feature flags / kill switches ---
FEATURE_MOCK_TRANSPORT=false
FLAG_PROVIDER_MUTATION_CODEX_RESET_CREDIT=false
KILLSWITCH_PROVIDER_OPENCODE_GO=false
KILLSWITCH_PROVIDER_GITHUB_COPILOT=false
KILLSWITCH_PROVIDER_CODEX=false
KILLSWITCH_PROVIDER_CLAUDE_CODE=false

# --- Worker (apps/connector-worker) ---
# Upstash Redis URL in production (serverless, free tier). redis://localhost for local dev.
REDIS_URL=redis://localhost:6379
QUEUE_REFRESH_NAME=refresh
WORKER_CONCURRENCY=1
JOB_TIMEOUT_MS=60000

# --- Database (Phase 4 connects this; required in production) ---
# Neon Postgres connection string (free tier for MVP).
DATABASE_URL=postgresql://devgauge:change-me@localhost:5432/devgauge
ENC_MASTER_KEY=replace-with-at-least-32-random-characters

# --- Object storage (Cloudflare R2 in production; local MinIO for dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=devgauge
S3_ACCESS_KEY_ID=devgauge
S3_SECRET_ACCESS_KEY=devgauge-secret

# --- Codex App Server ---
CODEX_BINARY_PATH=codex
CODEX_TEMP_DIR=/tmp
CODEX_LOGIN_TIMEOUT_MS=900000

# --- Placeholders for later phases; do not invent values ---
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# KMS_KEY_ID=
# PUSH_SERVICE_URL=
