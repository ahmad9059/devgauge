# Only non-secret EXPO_PUBLIC_* values can be exposed to the mobile bundle.
# APP_VARIANT=development
# Production defaults to app.devgauge. Override only for a separate distribution:
# ANDROID_PACKAGE=app.devgauge

# Antigravity uses the public Antigravity CLI OAuth client (an "installed app"
# credential). Copy the real values into a local .env (gitignored) before building.
# EXPO_PUBLIC_ANTIGRAVITY_CLIENT_ID=
# EXPO_PUBLIC_ANTIGRAVITY_CLIENT_SECRET=
