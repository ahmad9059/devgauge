{
  "name": "devgauge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "main": "index.js",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:preview-apk": "sh scripts/build-test-apk.sh",
    "android:release-apk": "sh scripts/build-release-apk.sh",
    "icons": "sh scripts/generate-icons.sh",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check app src scripts index.js app.config.ts vitest.config.mts eslint.config.mjs",
    "format": "prettier --write app src scripts index.js app.config.ts vitest.config.mts eslint.config.mjs",
    "test": "vitest run",
    "config:check": "node scripts/check-config.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "audit:policy-test": "node --test scripts/audit-policy.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run config:check"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "expo": "~57.0.27",
    "expo-background-task": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tab-view": "^4.3.3",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
